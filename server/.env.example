# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/ticketrush
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=supersecret-ticketrush-jwt-key-minimum-32-chars

# Booking & Flash Sale Constraints
HOLD_TTL_SECONDS=300
MAX_SEATS_PER_HOLD=6

# Waiting Room Queue
QUEUE_ADMIT_RATE=50
QUEUE_ADMIT_WINDOW_SECONDS=5

# CORS
CORS_ORIGIN=http://localhost:3000
